# Conexão local. Ajuste o nome do banco e o usuário para o seu PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atendimento_cliente
DB_USER=postgres
DB_PASSWORD=preencha_a_senha_do_postgresql

# Emails de atendentes autorizados à manutenção, separados por vírgulas.
# Lista vazia bloqueia a manutenção para todos.
MANUTENCAO_EMAILS=
